{
  "name": "ryos",
  "productName": "ryOS",
  "private": true,
  "version": "1.0.8",
  "description": "A web-based desktop operating system, reimagining classic Mac OS, Windows, and more.",
  "author": "Ryo Lu <me@ryo.lu> (https://ryo.lu)",
  "homepage": "https://os.ryo.lu",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=4096' vite --port ${PORT:-5173}",
    "dev:vite": "NODE_OPTIONS='--max-old-space-size=4096' vite --port ${PORT:-5173}",
    "version:bump": "bun run scripts/generate-build-version.ts --bump",
    "prebuild": "bun run scripts/generate-build-version.ts && bun run scripts/fetch-substack.ts",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "generate:icons": "bun run scripts/generate-icon-manifest.ts",
    "generate:substack": "bun run scripts/fetch-substack.ts",
    "generate:infinite-mac-thumbnails": "bun run scripts/generate-infinite-mac-thumbnails.ts",
    "generate:infinite-pc-thumbnails": "bun run scripts/generate-infinite-pc-thumbnails.ts",
    "generate:average-colors": "bun run scripts/compute-average-colors.ts",
    "generate:wallpapers": "bun run scripts/generate-wallpaper-manifest.ts && node --experimental-strip-types scripts/generate-wallpaper-placeholders.ts",
    "generate:wallpaper-placeholders": "node --experimental-strip-types scripts/generate-wallpaper-placeholders.ts",
    "generate:docs": "bun run scripts/generate-docs.ts",
    "launch-kiosk": "bash scripts/launch-kiosk.sh",
    "i18n:extract": "bun run scripts/extract-strings.ts",
    "i18n:sync": "bun run scripts/sync-translations.ts",
    "i18n:sync:dry-run": "bun run scripts/sync-translations.ts --dry-run",
    "i18n:sync:mark-todo": "bun run scripts/sync-translations.ts --mark-untranslated",
    "i18n:find-untranslated": "bun run scripts/find-untranslated-strings.ts",
    "test": "bun test",
    "test:unit": "bun test tests/test-error-boundary-wiring.test.ts tests/test-custom-wallpaper-processing.test.ts tests/test-shuffle-wallpaper-deterministic.test.ts tests/test-wallpaper-placeholders.test.ts tests/test-furigana-word-spacing.test.ts tests/test-app-drawer-layout.test.ts tests/test-ipod-apple-music.test.ts tests/test-ipod-playback-navigation.test.ts tests/test-offline-hook.test.ts tests/test-network-prefetch.test.ts tests/test-themed-icon-cache-recovery.test.ts tests/test-prefetch-manifest-flag.test.ts tests/test-reload-guard.test.ts tests/test-background-task.test.ts tests/test-shared-dialog-state.test.ts tests/test-performance-tier.test.ts tests/test-control-panels-mac-layout.test.ts tests/test-vfs-service-wiring.test.ts tests/test-dock-open-items.test.ts tests/test-project-config.test.ts tests/test-aqua-desktop-apps.test.ts tests/test-gallery-config.test.ts tests/test-docviewer-config.test.ts tests/test-fetch-substack.test.ts tests/test-substack-config.test.ts tests/test-terminal-bio-commands.test.ts tests/test-boot-layout.test.ts tests/test-barn-gag-timing.test.ts tests/test-go-engine.test.ts tests/test-go-app-wiring.test.ts tests/test-site-metadata.test.ts"
  },
  "dependencies": {
    "@cursor/sdk": "1.0.15",
